# Copy this file to .env and adjust. Nothing here is secret:
# the app signs in through its own browser window, so no cookie or key goes in this file.

# How often to check claude.ai, in seconds (minimum 60).
REFRESH_SECONDS=120

# Colour thresholds and notification points, in percent.
WARN_PERCENT=75
CRITICAL_PERCENT=90

# Which limit the tray icon shows: five_hour, seven_day, seven_day_sonnet, or highest.
TRAY_METRIC=five_hour

# Windows notifications when a limit crosses a threshold (true/false).
NOTIFICATIONS=true
